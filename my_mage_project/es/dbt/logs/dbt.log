  create  table "slinventoryDB"."gold"."order_fulfillment_metrics__dbt_tmp"
  
  
    as
  
  (
    WITH orders AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_orders"
),

totals AS (
    SELECT COUNT(*) AS grand_total_orders FROM orders
)

SELECT
    o.status,
    COUNT(o.order_id) AS total_orders,
    SUM(o.quantity) AS total_units,
    SUM(o.total_amount) AS total_revenue,
    ROUND((COUNT(o.order_id) * 100.0 / NULLIF(t.grand_total_orders, 0)), 2) AS percentage_of_total_orders
FROM orders o
CROSS JOIN totals t
GROUP BY o.status, t.grand_total_orders
ORDER BY total_orders DESC
  );
  
[0m12:17:53.057662 [debug] [Thread-2  ]: On model.inventory_dbt.sales_by_time_metrics: /* {"app": "dbt", "dbt_version": "1.10.22", "profile_name": "inventory_dbt", "target_name": "dev", "node_id": "model.inventory_dbt.sales_by_time_metrics"} */

  
    

  create  table "slinventoryDB"."gold"."sales_by_time_metrics__dbt_tmp"
  
  
    as
  
  (
    WITH orders AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_orders"
),

products AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_products"
)

SELECT
    p.product_name,
    p.category,
    EXTRACT(HOUR FROM o.created_at) AS order_hour,
    EXTRACT(MONTH FROM o.created_at) AS order_month,
    COUNT(o.order_id) AS total_orders,
    SUM(o.quantity) AS total_units_sold,
    SUM(o.total_amount) AS total_revenue
FROM orders o
INNER JOIN products p ON o.product_id = p.product_id
GROUP BY p.product_name, p.category, order_hour, order_month
ORDER BY order_month, order_hour, total_revenue DESC
  );
  

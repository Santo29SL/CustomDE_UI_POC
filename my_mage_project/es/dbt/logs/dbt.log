  create  table "slinventoryDB"."gold"."most_ordered_items__dbt_tmp"
  
  
    as
  
  (
    WITH orders AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_orders"
),

products AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_products"
)

SELECT
    p.product_name,
    p.category,
    SUM(o.quantity) AS total_quantity_sold,
    COUNT(o.order_id) AS total_orders,
    SUM(o.total_amount) AS total_revenue
FROM orders o
INNER JOIN products p ON o.product_id = p.product_id
GROUP BY p.product_name, p.category
ORDER BY total_quantity_sold DESC
  );
  
[0m07:00:12.244804 [debug] [Thread-1 (]: SQL status: BEGIN in 0.006 seconds
[0m07:00:12.245410 [debug] [Thread-1 (]: Using postgres connection "model.inventory_dbt.sales_by_time_metrics"
[0m07:00:12.245125 [debug] [Thread-4 (]: On model.inventory_dbt.order_fulfillment_metrics: /* {"app": "dbt", "dbt_version": "1.8.7", "profile_name": "inventory_dbt", "target_name": "dev", "node_id": "model.inventory_dbt.order_fulfillment_metrics"} */

  
    

  create  table "slinventoryDB"."gold"."order_fulfillment_metrics__dbt_tmp"
  
  
    as
  
  (
    WITH orders AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_orders"
),

totals AS (
    SELECT COUNT(*) AS grand_total_orders FROM orders
)

SELECT
    o.status,
    COUNT(o.order_id) AS total_orders,
    SUM(o.quantity) AS total_units,
    SUM(o.total_amount) AS total_revenue,
    ROUND((COUNT(o.order_id) * 100.0 / NULLIF(t.grand_total_orders, 0)), 2) AS percentage_of_total_orders
FROM orders o
CROSS JOIN totals t
GROUP BY o.status, t.grand_total_orders
ORDER BY total_orders DESC
  );
  
[0m07:00:12.244943 [debug] [Thread-2 (]: Using postgres connection "model.inventory_dbt.customer_order_metrics"
[0m07:00:12.245815 [debug] [Thread-2 (]: On model.inventory_dbt.customer_order_metrics: /* {"app": "dbt", "dbt_version": "1.8.7", "profile_name": "inventory_dbt", "target_name": "dev", "node_id": "model.inventory_dbt.customer_order_metrics"} */

  
    

  create  table "slinventoryDB"."gold"."customer_order_metrics__dbt_tmp"
  
  
    as
  
  (
    WITH orders AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_orders"
),

users AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_users"
)

SELECT
    u.name,
    u.email,
    AVG(o.total_amount) AS avg_order_value,
    MIN(o.total_amount) AS min_order_value,
    MAX(o.total_amount) AS max_order_value,
    COUNT(o.order_id) AS total_orders_placed,
    SUM(o.total_amount) AS total_amount_spent
FROM orders o
INNER JOIN users u ON o.customer_id = u.user_id
GROUP BY u.name, u.email
  );
  
[0m07:00:12.245567 [debug] [Thread-1 (]: On model.inventory_dbt.sales_by_time_metrics: /* {"app": "dbt", "dbt_version": "1.8.7", "profile_name": "inventory_dbt", "target_name": "dev", "node_id": "model.inventory_dbt.sales_by_time_metrics"} */

  
    

  create  table "slinventoryDB"."gold"."sales_by_time_metrics__dbt_tmp"
  
  
    as
  
  (
    WITH orders AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_orders"
),

products AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_products"
)

SELECT
    p.product_name,
    p.category,
    EXTRACT(HOUR FROM o.created_at) AS order_hour,
    EXTRACT(MONTH FROM o.created_at) AS order_month,
    COUNT(o.order_id) AS total_orders,
    SUM(o.quantity) AS total_units_sold,
    SUM(o.total_amount) AS total_revenue
FROM orders o
INNER JOIN products p ON o.product_id = p.product_id
GROUP BY p.product_name, p.category, order_hour, order_month
ORDER BY order_month, order_hour, total_revenue DESC
  );
  

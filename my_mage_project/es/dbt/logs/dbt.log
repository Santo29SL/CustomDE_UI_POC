  create  table "slinventoryDB"."gold"."inventory_stock_urgency__dbt_tmp"
  
  
    as
  
  (
    WITH products AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_products"
),

pending_restocks AS (
    SELECT
        product_id,
        SUM(requested_quantity) AS total_pending_restock_qty,
        COUNT(restock_id) AS pending_restock_requests_count
    FROM "slinventoryDB"."silver"."stg_restocks"
    WHERE status = 'pending'
    GROUP BY product_id
)

SELECT
    p.product_id,
    p.product_name,
    p.category,
    p.quantity AS current_stock,
    p.reorder_level,
    CASE
        WHEN p.quantity = 0 THEN 'OUT OF STOCK'
        WHEN p.quantity <= p.reorder_level THEN 'LOW STOCK'
        ELSE 'HEALTHY'
    END AS stock_status,
    COALESCE(r.total_pending_restock_qty, 0) AS pending_restock_quantity,
    COALESCE(r.pending_restock_requests_count, 0) AS pending_restock_requests
FROM products p
LEFT JOIN pending_restocks r ON p.product_id = r.product_id
ORDER BY 
    CASE 
        WHEN p.quantity = 0 THEN 1
        WHEN p.quantity <= p.reorder_level THEN 2
        ELSE 3
    END ASC, 
    p.quantity ASC
  );
  
[0m07:10:44.438499 [debug] [Thread-4  ]: SQL status: BEGIN in 0.005 seconds
[0m07:10:44.438669 [debug] [Thread-4  ]: Using postgres connection "model.inventory_dbt.order_fulfillment_metrics"
[0m07:10:44.438847 [debug] [Thread-4  ]: On model.inventory_dbt.order_fulfillment_metrics: /* {"app": "dbt", "dbt_version": "1.9.0b2", "profile_name": "inventory_dbt", "target_name": "dev", "node_id": "model.inventory_dbt.order_fulfillment_metrics"} */

  
    

  create  table "slinventoryDB"."gold"."order_fulfillment_metrics__dbt_tmp"
  
  
    as
  
  (
    WITH orders AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_orders"
),

totals AS (
    SELECT COUNT(*) AS grand_total_orders FROM orders
)

SELECT
    o.status,
    COUNT(o.order_id) AS total_orders,
    SUM(o.quantity) AS total_units,
    SUM(o.total_amount) AS total_revenue,
    ROUND((COUNT(o.order_id) * 100.0 / NULLIF(t.grand_total_orders, 0)), 2) AS percentage_of_total_orders
FROM orders o
CROSS JOIN totals t
GROUP BY o.status, t.grand_total_orders
ORDER BY total_orders DESC
  );
  

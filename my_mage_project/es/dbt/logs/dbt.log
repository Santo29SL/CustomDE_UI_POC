  create  table "slinventoryDB"."gold"."order_fulfillment_metrics__dbt_tmp"
  
  
    as
  
  (
    WITH orders AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_orders"
),

totals AS (
    SELECT COUNT(*) AS grand_total_orders FROM orders
)

SELECT
    o.status,
    COUNT(o.order_id) AS total_orders,
    SUM(o.quantity) AS total_units,
    SUM(o.total_amount) AS total_revenue,
    ROUND((COUNT(o.order_id) * 100.0 / NULLIF(t.grand_total_orders, 0)), 2) AS percentage_of_total_orders
FROM orders o
CROSS JOIN totals t
GROUP BY o.status, t.grand_total_orders
ORDER BY total_orders DESC
  );
  
[0m19:00:01.637535 [debug] [Thread-1  ]: On model.inventory_dbt.customer_order_metrics: /* {"app": "dbt", "dbt_version": "1.10.22", "profile_name": "inventory_dbt", "target_name": "dev", "node_id": "model.inventory_dbt.customer_order_metrics"} */

  
    

  create  table "slinventoryDB"."gold"."customer_order_metrics__dbt_tmp"
  
  
    as
  
  (
    WITH orders AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_orders"
),

users AS (
    SELECT * FROM "slinventoryDB"."silver"."stg_users"
)

SELECT
    u.name,
    u.email,
    AVG(o.total_amount) AS avg_order_value,
    MIN(o.total_amount) AS min_order_value,
    MAX(o.total_amount) AS max_order_value,
    COUNT(o.order_id) AS total_orders_placed,
    SUM(o.total_amount) AS total_amount_spent
FROM orders o
INNER JOIN users u ON o.customer_id = u.user_id
GROUP BY u.name, u.email
  );
  

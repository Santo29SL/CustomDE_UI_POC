FROM mageai/mageai:latest

# Install Java 17, procps, and wget
RUN apt-get update && \
    apt-get install -y openjdk-17-jdk-headless procps wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set Spark environment variables
ENV SPARK_VERSION=3.5.1
ENV HADOOP_VERSION=3
ENV SPARK_HOME=/opt/spark
ENV PATH=$PATH:$SPARK_HOME/bin

# Download and extract Spark directly
RUN wget -q https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz -O /tmp/spark.tgz && \
    tar -xzf /tmp/spark.tgz -C /opt && \
    mv /opt/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION} ${SPARK_HOME} && \
    rm /tmp/spark.tgz

# Install PySpark matching the Spark version
RUN pip install pyspark==3.5.1
